{
  "name": "react_phone-catalog",
  "version": "1.0.0",
  "keywords": [
    "Course",
    "Full-Stack",
    "Mate Academy",
    "Shop"
  ],
  "author": "Michał Szwindowski",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.2",
    "@tanstack/react-query": "^5.90.16",
    "classnames": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.25.1",
    "react-transition-group": "^4.4.5"
  },
  "devDependencies": {
    "@cypress/react18": "^2.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-transition-group": "^4.4.10",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/ui": "^4.0.14",
    "cypress": "^13.13.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-cypress": "^3.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "prettier": "^3.3.2",
    "sass": "^1.77.8",
    "stylelint": "^16.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.0.14"
  },
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:gh": "vite build --mode gh-pages",
    "typecheck": "tsc --noEmit",
    "build:full": "npm run typecheck && npm run build",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --cache --cache-location .eslintcache",
    "lint:fix": "npm run lint -- --fix",
    "lint:ci": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --max-warnings=0",
    "lint:styles": "stylelint \"src/**/*.{css,scss}\"",
    "lint:styles:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,scss,md}\"",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ci": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run lint:styles && npm run test:run",
    "check:ci": "npm run check && npm run test:e2e",
    "preview": "vite preview",
    "audit": "npm audit --omit=dev",
    "prepare": "husky install"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
